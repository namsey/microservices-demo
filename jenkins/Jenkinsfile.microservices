@Library('jenkins-shared-lib') _

def services = [
  'adservice',
  'cartservice',
  'checkoutservice',
  'currencyservice',
  'emailservice',
  'frontend',
  'loadgenerator',
  'paymentservice',
  'productcatalogservice',
  'recommendationservice',
  'shippingservice',
  'shoppingassistantservice'
]

node {
  stage('Parallel CI for Microservices') {
    parallel services.collectEntries { service ->
      ["${service}": {
        node(kubernetesAgent(service)) {
          buildApp(service: service)
          runTests(service: service)
          dockerBuildPush(service: service, imageRepo: "304230205815.dkr.ecr.us-east-1.amazonaws.com/ecommerce/microservices")
        }
      }]
    }
  }
}
