@Library('jenkins-shared-lib') _

pipeline {
  environment {
  ORG_GRADLE_JAVA_INSTALLATIONS_AUTO_DOWNLOAD = 'true'
  S3_BUCKET = 'jenkins-build-artifacts-2025'
  AWS_REGION = 'us-east-1'
}
  agent {
    kubernetes {
      label 'jenkins-jenkins-agent'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build') {
      steps {
        dir("src/adservice") {
          buildApp(service: '.')
        }
      }
    }
    stage('Upload to S3') {
      steps {
        dir('src/adservice') {
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
            sh '''
              aws --version
              echo "📦 Listing build/libs contents before upload:"
              ls -lh build/libs/
              aws s3 cp build/libs/ s3://$S3_BUCKET/adservice/ --recursive --region $AWS_REGION
              echo "✅ Verifying upload:"
              aws s3 ls s3://$S3_BUCKET/adservice/ --region $AWS_REGION
            '''
          }
        }
      }
    }
    stage('Docker build & push to ECR') {
  environment {
    AWS_REGION = 'us-east-1'
    ECR_REPO   = 'adservice'                 // your repo name
    DOCKERFILE = 'src/adservice/Dockerfile'  // path to Dockerfile
    CONTEXT    = 'src/adservice'             // build context
  }
  steps {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
      sh '''
        set -euo pipefail
        ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
        REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        TAG="$(git rev-parse --short=7 HEAD || echo no-git)-${BUILD_NUMBER}"

        # ensure repo exists (safe if already there)
        aws ecr describe-repositories --repository-names "$ECR_REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
          aws ecr create-repository --repository-name "$ECR_REPO" \
            --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"

        # login to ECR for Docker
        aws ecr get-login-password --region "$AWS_REGION" | \
          docker login --username AWS --password-stdin "$REGISTRY"

        # build & tag
        docker build -t "$REGISTRY/$ECR_REPO:$TAG" -t "$REGISTRY/$ECR_REPO:latest" \
          -f "$DOCKERFILE" "$CONTEXT"

        # push
        docker push "$REGISTRY/$ECR_REPO:$TAG"
        docker push "$REGISTRY/$ECR_REPO:latest"

        echo "Pushed: $REGISTRY/$ECR_REPO:$TAG"
        echo "Pushed: $REGISTRY/$ECR_REPO:latest"
      '''
    }
  }
}      
  }
}
