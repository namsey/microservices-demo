@Library('jenkins-shared-lib') _
echo "✅ Shared library loaded successfully"
pipeline {
  agent {
    kubernetes {
      label 'java-builder'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build') {
      steps {
        dir("src/adservice") {
          buildApp(service: '.')
        }
      }
    }
  }
}
