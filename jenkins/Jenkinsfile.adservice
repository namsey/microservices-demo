@Library('jenkins-shared-lib') _

pipeline {
  environment {
  ORG_GRADLE_JAVA_INSTALLATIONS_AUTO_DOWNLOAD = 'true'
  S3_BUCKET = 'jenkins-build-artifacts-2025'
  AWS_REGION = 'us-east-1'
}
  agent {
    kubernetes {
      label 'java-builder'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build') {
      steps {
        dir("src/adservice") {
          buildApp(service: '.')
        }
      }
    }
    stage('Upload to S3') {
      steps {
        dir('src/adservice') {
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
            sh '''
              echo "🔧 Installing unzip and AWS CLI..."
              apk add --no-cache unzip curl bash
              echo "🔧 Installing AWS CLI..."
              curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
              unzip awscliv2.zip
              ./aws/install -i /usr/local/aws-cli -b /usr/local/bin
              aws --version
              echo "📦 Listing build/libs contents before upload:"
              ls -lh build/libs/
              aws s3 cp build/libs/ s3://$S3_BUCKET/adservice/ --recursive --region $AWS_REGION
              echo "✅ Verifying upload:"
              aws s3 ls s3://$S3_BUCKET/adservice/ --region $AWS_REGION
            '''
          }
        }
      }
    }
  }
}
