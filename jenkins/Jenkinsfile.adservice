@Library('jenkins-shared-lib') _

pipeline {
  environment {
  ORG_GRADLE_JAVA_INSTALLATIONS_AUTO_DOWNLOAD = 'true'
}
  agent {
    kubernetes {
      label 'java-builder'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build') {
      steps {
        dir("src/adservice") {
          buildApp(service: '.')
        }
      }
    }
  }
}
