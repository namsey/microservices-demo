@Library('jenkins-shared-lib') _

pipeline {
  environment {
  ORG_GRADLE_JAVA_INSTALLATIONS_AUTO_DOWNLOAD = 'true'
}
  agent {
    kubernetes {
      label 'jenkins-jenkins-agent'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build & Push adservice (Kaniko -> ECR)') {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: awscli
    image: public.ecr.aws/aws-cli/aws-cli:2        # <-- FIXED
    command: ['cat']                               # keep container alive
    tty: true
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2  # pin a recent version
    command: ['cat']                               # <-- FIXED (no args)
    tty: true
    volumeMounts:
    - name: kaniko-cache
      mountPath: /kaniko/cache
  volumes:
  - name: kaniko-cache
    emptyDir: {}
"""
    }
  }
  environment {
    ECR_REPO   = 'adservice'
    BUILD_CTX  = 'src/adservice'
    DOCKERFILE = 'src/adservice/Dockerfile'
    // AWS_REGION is already defined at top-level in your pipeline
  }
  steps {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
      script {
        def ciTag = sh(script: "git rev-parse --short=7 HEAD || echo no-git", returnStdout: true).trim() + "-${env.BUILD_NUMBER}"

        // 1) Discover registry + ensure repo exists
        container('awscli') {
          sh '''
            set -euo pipefail
            : "${AWS_REGION:=us-east-1}"
            ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
            REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
            echo -n "$REGISTRY" > .ecr_registry

            aws ecr describe-repositories --repository-names "$ECR_REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
              aws ecr create-repository --repository-name "$ECR_REPO" \
                --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"
          '''
        }
        def registry = sh(script: "cat .ecr_registry", returnStdout: true).trim()
        def imgCi  = "${registry}/${env.ECR_REPO}:${ciTag}"
        def imgLat = "${registry}/${env.ECR_REPO}:latest"

        // 2) Build & push with Kaniko
        container('kaniko') {
          sh """
            set -euo pipefail
            /kaniko/executor \
              --context="${WORKSPACE}/${BUILD_CTX}" \
              --dockerfile="${WORKSPACE}/${DOCKERFILE}" \
              --destination="${imgCi}" \
              --destination="${imgLat}" \
              --cache=true --cache-ttl=168h
          """
        }

        echo "✅ Pushed: ${imgCi}"
        echo "✅ Pushed: ${imgLat}"
        writeFile file: 'adservice-image.txt', text: imgCi
      }
    }
  }
}
  }
}
