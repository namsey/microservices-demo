@Library('jenkins-shared-lib') _

pipeline {
  environment {
  ORG_GRADLE_JAVA_INSTALLATIONS_AUTO_DOWNLOAD = 'true'
  S3_BUCKET = 'jenkins-build-artifacts-2025'
  AWS_REGION = 'us-east-1'
}
  agent {
    kubernetes {
      label 'jenkins-jenkins-agent'
      defaultContainer 'jnlp'
    }
  }

  stages {
    stage('Build') {
      steps {
        dir("src/adservice") {
          buildApp(service: '.')
        }
      }
    }
    stage('Upload to S3') {
      steps {
        dir('src/adservice') {
          withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
            sh '''
              aws --version
              echo "📦 Listing build/libs contents before upload:"
              ls -lh build/libs/
              aws s3 cp build/libs/ s3://$S3_BUCKET/adservice/ --recursive --region $AWS_REGION
              echo "✅ Verifying upload:"
              aws s3 ls s3://$S3_BUCKET/adservice/ --region $AWS_REGION
            '''
          }
        }
      }
    }
    stage('Build & Push adservice (Kaniko -> ECR)') {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: awscli
    image: amazon/aws-cli:2
    command: ['cat']
    tty: true
  - name: kaniko
    image: gcr.io/kaniko-project/executor:latest
    args: ['--ignore-path=/dev/null']
    tty: true
    volumeMounts:
    - name: kaniko-cache
      mountPath: /kaniko/cache
  volumes:
  - name: kaniko-cache
    emptyDir: {}
"""
    }
  }
  environment {
    ECR_REPO   = 'adservice'
    BUILD_CTX  = 'src/adservice'
    DOCKERFILE = 'src/adservice/Dockerfile'
  }
  steps {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-s3-creds']]) {
      script {
        def ciTag = sh(script: "git rev-parse --short=7 HEAD || echo no-git", returnStdout: true).trim() + "-${env.BUILD_NUMBER}"

        // 1) Discover registry and ensure repo exists
        container('awscli') {
          sh '''
            set -euo pipefail
            : "${AWS_REGION:=us-east-1}"
            ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
            REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
            echo -n "$REGISTRY" > .ecr_registry

            aws ecr describe-repositories --repository-names "$ECR_REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
              aws ecr create-repository --repository-name "$ECR_REPO" \
                --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"
          '''
        }
        def registry = sh(script: "cat .ecr_registry", returnStdout: true).trim()
        def img1 = "${registry}/${env.ECR_REPO}:${ciTag}"
        def img2 = "${registry}/${env.ECR_REPO}:latest"

        // 2) Build & push with Kaniko
        container('kaniko') {
          sh """
            set -euo pipefail
            /kaniko/executor \
              --context="${WORKSPACE}/${BUILD_CTX}" \
              --dockerfile="${WORKSPACE}/${DOCKERFILE}" \
              --destination="${img1}" \
              --destination="${img2}" \
              --cache=true --cache-ttl=168h
          """
        }
        echo "✅ Pushed: ${img1}"
        echo "✅ Pushed: ${img2}"
        writeFile file: 'adservice-image.txt', text: img1
      }
    }
  }
}

  }
}
